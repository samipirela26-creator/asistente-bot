[Unit]
Description=Bot de agenda personal por Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/sanuel/Escritorio/SP/sistema-escolar/asistente
ExecStart=/usr/bin/python3 /home/sanuel/Escritorio/SP/sistema-escolar/asistente/bot.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Nice=10
CPUWeight=20
MemoryMax=300M
NoNewPrivileges=true

[Install]
WantedBy=default.target
